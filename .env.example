# SAMVAAD environment template. Copy to .env.local and edit. Placeholders only: never commit real secrets.
#   PowerShell:  Copy-Item .env.example .env.local

# --- Demo mode -------------------------------------------------------------------------------
# true  (default): fictional demo data is seeded on first run and the demo persona picker is available.
# false: disables demo sign-in. Real authentication is NOT implemented yet, so nobody can sign in.
DEMO_MODE=true

# Sessions are random server-side tokens (only a SHA-256 hash is stored in SQLite); there is no signing secret to configure.
# Set SAMVAAD_HTTPS=true behind HTTPS so HSTS and upgrade-insecure-requests are sent (the cookie is already Secure in production builds).
# SAMVAAD_HTTPS=true

# Where the SQLite file lives (relative to the project root). Ignored by git.
SAMVAAD_DB_PATH=./data/samvaad.db

# --- AI provider -----------------------------------------------------------------------------
# demo      (default) deterministic, offline, clearly labelled "Simulated AI output". No key, no cost.
# anthropic real model via the Anthropic Messages API. Requires the two variables below.
AI_PROVIDER=demo

# Only needed when AI_PROVIDER=anthropic. Server-side only; never exposed to the browser or logged.
# Get a key from https://console.anthropic.com/ (requires an account with credits).
ANTHROPIC_API_KEY=
# The model id to use, e.g. a current Claude model from https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_MODEL=
# Optional override for proxies or tests.
# ANTHROPIC_BASE_URL=

# Trust X-Forwarded-For for per-client rate limiting. Only behind a proxy that overwrites the header.
# SAMVAAD_TRUST_PROXY=true
